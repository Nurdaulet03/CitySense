# Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/citysense
# For MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/citysense?retryWrites=true&w=majority

# Session Security
# Generate a random string (min 32 characters) for production
SESSION_SECRET=citysense_session_secret_change_in_production

# API Keys
# Get your free API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Optional: OpenAI API key for AI features
# If not provided, AI will use rule-based fallback responses
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# CORS Configuration
# Frontend URL for CORS (update after deploying frontend)
FRONTEND_URL=http://localhost:3000
# Production example:
# FRONTEND_URL=https://your-app.vercel.app
